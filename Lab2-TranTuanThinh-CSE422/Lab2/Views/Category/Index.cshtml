@model IEnumerable<Lab2.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h2 style="font-family: Arial, sans-serif; color: #333;">Categories</h2>

<div style="margin-bottom: 20px;">
    <a href="/Category/Create" style="display: inline-block; padding: 10px 15px; background-color: #007bff; color: #fff; text-decoration: none; border-radius: 5px; font-size: 14px;">
        Create New Category
    </a>
</div>

<table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; margin-top: 10px; box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);">
    <thead>
        <tr style="background-color: #007bff; color: #fff; text-align: left;">
            <th style="padding: 10px; border: 1px solid #ddd;">Name</th>
            <th style="padding: 10px; border: 1px solid #ddd; width: 150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr style="background-color: #f9f9f9; border-bottom: 1px solid #ddd;">
                <td style="padding: 10px; border: 1px solid #ddd;">@category.Name</td>
                <td style="padding: 10px; border: 1px solid #ddd; text-align: center;">
                    <a href="/Category/Edit/@category.Id" style="color: #007bff; text-decoration: none; margin-right: 10px;">Edit</a>
                    <a href="/Category/Delete/@category.Id" style="color: #dc3545; text-decoration: none;">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
